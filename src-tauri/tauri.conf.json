{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeeMyGame",
  "version": "1.0.0",
  "identifier": "com.seemygame.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:dist",
    "beforeBuildCommand": "npm run build:dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeeMyGame",
        "url": "index.html",
        "x": 100,
        "y": 100,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://unpkg.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: ws://localhost:9876; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../native-media/": "native-media/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
