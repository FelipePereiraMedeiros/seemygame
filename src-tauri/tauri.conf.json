{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeeMyGame",
  "version": "1.0.0",
  "identifier": "com.seemygame.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:dist",
    "beforeBuildCommand": "npm run build:dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeeMyGame",
        "url": "index.html",
        "x": 100,
        "y": 100,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
