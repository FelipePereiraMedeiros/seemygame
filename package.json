{
  "name": "seemygame",
  "version": "1.0.0",
  "description": "Plataforma de streaming P2P em tempo real com foco em alta fluidez e baixa latência",
  "type": "module",
  "scripts": {
    "build:dist": "node tools/build-dist.js",
    "serve": "node tools/serve.mjs",
    "web": "node tools/serve.mjs",
    "desktop": "node tools/build-dist.js && cargo run --manifest-path src-tauri/Cargo.toml --release",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "test": "vitest run",
    "test:smoke": "node tools/smoke-esm.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:whiteboard": "node tests/e2e-whiteboard.mjs",
    "native:prepare": "node tools/build-dist.js",
    "native:smoke": "cargo check --manifest-path src-tauri/Cargo.toml --locked --offline --lib"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "gaming",
    "ultra-smooth",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "peerjs": "1.5.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "vitest": "^5.0.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "three": "^0.186.1"
  }
}
